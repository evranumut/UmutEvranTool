                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- SEKME 3: WINDOWS OZELLIKLERI (DISM), HIZLI DNS, DERIN TEMIZLIK & WINDOWS UPDATE -->
